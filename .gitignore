cat > .gitignore <<'EOF'
# Python
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# Environment variables / secrets
.env
.env.*
!.env.example

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Python packaging
*.egg-info/
dist/
build/

# Model files
*.bin
*.pt
*.pth
*.ckpt
*.safetensors

# Large generated files
*.npy
*.npz
*.pkl

# Local indexes / caches
.faiss/
*.index

# Dataset files
*.parquet
*.csv

# Temporary files
tmp/
temp/
EOF
# Generated QA evaluation files
results/human_eval_50.jsonl
results/human_eval_50_results.jsonl
results/qa_predictions.jsonl
results/qa_prompts_validation.jsonl
results/qa_prompts_validation_100.jsonl
results/qa_predictions_validation_100.jsonl
results/qa_predictions_test_100.jsonl
results/qa_prompts_test_100.jsonl

# Keep project dataset files in Git LFS
!data/raw/*.parquet
!data/processed/*.parquet
!data/processed/*.csv
